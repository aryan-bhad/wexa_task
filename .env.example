# CognoDB Cloud Database Connection Secrets
# Copy this file to .env.local and fill in your CognoDB instance connection details.
# NEVER commit your actual password or connection URI to git!

NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud:7687
NEO4J_USER=cognodb
NEO4J_PASSWORD=<your-generated-cognodb-password>
